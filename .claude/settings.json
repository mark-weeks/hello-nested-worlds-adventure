{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(./setup.sh)",
      "Bash(./scripts/check.sh)",
      "Bash(ENFOLDED_E2E=1 ./scripts/check.sh)",
      "Bash(.venv/bin/ruff check:*)",
      "Bash(.venv/bin/python -m pytest tests/:*)",
      "Bash(.venv/bin/python scripts/verify_wheel.py)",
      "Bash(npm test --prefix frontend:*)",
      "Bash(npm run build --prefix frontend)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ]
  }
}
