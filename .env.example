# Text provider. Unset or anthropic keeps the current adapter. The Anthropic
# SDK is the optional extra enfolded[anthropic]. An unknown name fails startup.
# See docs/development/agent-runtime.md. These are replaceable code defaults,
# not a permanent vendor or model recommendation. The model ids below are the
# anthropic adapter's defaults. openai_compatible supplies none and fails
# startup until every task id is set. Another adapter supplies its own; an
# adapter with none fails startup when a task would use the default. Model ids must
# be ones the selected adapter serves; verify them before live use.
# NESTED_WORLDS_PROVIDER=anthropic
# openai_compatible is a second built-in for evaluation. No destination is
# approved for production, and these lines stay commented. It does not read
# OPENAI_* or XAI_*. It has no default model id: set all four task models
# before selecting it. The base URL and the API key are never logged.
# See docs/development/agent-runtime.md. ADR-035 (Proposed) does not enable
# a destination.
# NESTED_WORLDS_OPENAI_COMPATIBLE_BASE_URL=https://example.invalid/v1
# NESTED_WORLDS_OPENAI_COMPATIBLE_API_KEY=
# NESTED_WORLDS_OPENAI_COMPATIBLE_MAX_TOKENS_PARAM=max_completion_tokens
# NESTED_WORLDS_OPENAI_COMPATIBLE_STRUCTURED_OUTPUTS=
# NESTED_WORLDS_OPENAI_COMPATIBLE_SEND_STORE_FALSE=
# NESTED_WORLDS_OPENAI_COMPATIBLE_REASONING_EFFORT=
# NESTED_WORLDS_OPENAI_COMPATIBLE_TIMEOUT_SECONDS=60
# NESTED_WORLDS_OPENAI_COMPATIBLE_CONCURRENCY=8
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Alternatively, unset ANTHROPIC_API_KEY and provide a bearer token:
# ANTHROPIC_AUTH_TOKEN=your_anthropic_auth_token_here
# Shared model id for node voice, inhabitant voice, and intention
# interpretation when a task does not set its own. A model id selects a
# model on the implemented provider; it does not switch providers.
NESTED_WORLDS_MODEL=claude-opus-4-8
# Optional per-task model ids. Leave unset to keep the shared id above.
# Do not set a line to empty or whitespace: `python main.py serve` refuses
# that, even though a live call would have treated it as unset. These do not
# switch providers, and a failed call is not retried on another id.
# NESTED_WORLDS_NODE_MODEL=
# NESTED_WORLDS_INHABITANT_MODEL=
# NESTED_WORLDS_INTENT_MODEL=
# On the current adapter, an id that does not name Claude fails startup
# unless ANTHROPIC_BASE_URL is set to a non-blank gateway host. A Claude-shaped
# alias warns and still boots. The moderation model is checked even when
# NESTED_WORLDS_DISABLE_MODERATION=1. Before a release or Fly deploy, with
# these variables set as the machine will see them:
#   python main.py models
# That check does not call the provider. One tiny live call per distinct id
# is opt-in and is never used by tests, CI, or server startup. Without a
# credential it prints `skipped: provider not configured` and exits 1:
#   python main.py models --probe

# One shared hosted world. Choose this once before launch; changing it later
# points the server at a different persistent world. Empty/off is local-dev
# multi-world mode only and must never be used for a public deployment.
NESTED_WORLDS_CANONICAL_SEED=382

# fal.ai — AI scene image generation (fal-ai/fast-sdxl)
FAL_KEY=your_fal_api_key_here

# Beta hardening — leave unset in dev. The README "Setup" table documents every
# variable and its default; this file lists the ones an operator usually sets.
# There is no shared invite key: the gate is the per-user `invite_keys` table.
# Mint per-user keys with `python main.py invite mint --name <player>`; minting
# the first one closes the gate so every request needs ?key=... or X-Beta-Key.
# Daily caps on paid external API calls (UTC). Counters live in SQLite.
NESTED_WORLDS_ANTHROPIC_DAILY_CALLS=500
NESTED_WORLDS_FAL_DAILY_CALLS=200
# Per-credential daily sub-caps so one account cannot drain the shared budget.
NESTED_WORLDS_ANTHROPIC_DAILY_CALLS_PER_USER=150
NESTED_WORLDS_FAL_DAILY_CALLS_PER_USER=60
# Max in-flight calls for the anthropic provider. The name is unchanged.
# Another provider uses NESTED_WORLDS_<NAME>_CONCURRENCY (default 8) and
# does not share this limit.
NESTED_WORLDS_ANTHROPIC_CONCURRENCY=8
# Per-IP requests/min on the write routes (/speak, /agent/voice, /image,
# /puzzle/attempt, /act, /interventions/commit, journal/profile/situation
# writes, /register, /client-error) and on API reads.
NESTED_WORLDS_RATE_LIMIT_PER_MIN=20
NESTED_WORLDS_RATE_LIMIT_GET_PER_MIN=120
# Failed Ideas credential checks per minute per IP before 429.
NESTED_WORLDS_IDEAS_AUTH_FAILURES_PER_MIN=120
# Concurrent WebSocket connection caps (global, and per client IP).
NESTED_WORLDS_MAX_WS_CONNECTIONS=128
NESTED_WORLDS_MAX_WS_PER_IP=8
# Seconds to finish reading an HTTP request line, headers, and body.
# Applies until a WebSocket upgrade completes; the session then uses its
# own 60s idle timer. A stalled client cannot hold a thread past this.
NESTED_WORLDS_HTTP_READ_TIMEOUT=30
# Seconds one response send may block when the client stops reading.
# Not a limit on the whole response: a client that keeps accepting bytes
# continues. A silent reader is dropped and the handler slot is freed.
# The WebSocket upgrade replaces this with the same 60s idle timer.
NESTED_WORLDS_HTTP_WRITE_TIMEOUT=30
# Threads inside HTTP requests and open WebSocket sessions. Above this,
# new connections receive 503 with Retry-After and are not queued.
NESTED_WORLDS_MAX_HANDLER_THREADS=160
# Kill switches — set to "1" to disable.
NESTED_WORLDS_DISABLE_AI=
NESTED_WORLDS_DISABLE_IMAGES=
# Input moderation (ADR-004 §2). Two-tier screen on shared player text:
# a local filter, then one classify call for ambiguous inputs only.
# Shared text is held when it cannot be judged. A local clean line still
# publishes during a provider outage. Private notes stay unscreened.
# NESTED_WORLDS_MODERATION_MODEL does not fall back to NESTED_WORLDS_MODEL.
# A blank value fails startup. A non-Claude id fails startup unless
# ANTHROPIC_BASE_URL is set. The id is still checked when
# NESTED_WORLDS_DISABLE_MODERATION=1.
# Set to 1 to hold every shared line and refuse new registered names.
# Local multi-world `play --name` is not screened. That name can still be
# written as player_name on chronicle rows in this same database.
# `invite mint --unscreened` is the operator override that still mints a key.
NESTED_WORLDS_DISABLE_MODERATION=
NESTED_WORLDS_MODERATION_MODEL=claude-haiku-4-5
# Shared daily cap on classify calls (its own budget — never drains the
# voice budget). When exhausted, text that still needs a classifier is held.
NESTED_WORLDS_MODERATION_DAILY_CALLS=2000
# Starting per-user caps, to be measured. Open when no credential is sent.
# Classify calls per credential, checked before the shared counter above.
NESTED_WORLDS_MODERATION_DAILY_CALLS_PER_USER=60
# Moderation-triggering actions per credential (shared lines, ideas,
# a published profile, a puzzle guess). Name checks do not use this cap.
# A local block does not spend it. A clean line still does.
NESTED_WORLDS_MODERATION_ACTIONS_PER_USER=600
# Model-calling actions per credential. Does not touch the anthropic bucket.
NESTED_WORLDS_MODEL_ACTIONS_PER_USER=200
# Hot-tunable comma-separated extensions to the block / watch term lists.
NESTED_WORLDS_MODERATION_BLOCK_EXTRA=
NESTED_WORLDS_MODERATION_WATCH_EXTRA=
# Ambient world heartbeat (FSM agents, zero API spend): "0" disables it;
# the interval is seconds between ticks (default 180).
NESTED_WORLDS_HEARTBEAT=
NESTED_WORLDS_HEARTBEAT_INTERVAL=
# Causal travel time: seconds between rings of a staged cascade (default 12).
NESTED_WORLDS_HOP_DELAY=
# Set to "0" to disable the pump thread that drains staged causal hops,
# matured verbs, situation consequences and expressive work.
NESTED_WORLDS_CAUSAL_PUMP=
# Multiplier on the cosmic-scale verb maturation clocks; "0" = instant.
# For tests and impatient operators only.
NESTED_WORLDS_MATURATION_SCALE=
# History pruning is continuity-violating and double-gated. Leave both unset.
NESTED_WORLDS_MUTATION_TTL_DAYS=
NESTED_WORLDS_ALLOW_HISTORY_PRUNE=
# Set to "1" only when behind a trusted reverse proxy. The limiter then reads
# the real client IP from a proxy-set header (see below) — never the
# client-spoofable left-most X-Forwarded-For.
NESTED_WORLDS_TRUST_PROXY=
# Trusted client-IP header used when TRUST_PROXY=1. Defaults to Fly-Client-IP
# (Fly overwrites it with the true client IP). Set to CF-Connecting-IP behind
# Cloudflare, etc. If absent at request time, the right-most X-Forwarded-For
# entry (the hop the trusted proxy appended) is used as a fallback.
NESTED_WORLDS_CLIENT_IP_HEADER=Fly-Client-IP

# Sentry — optional. `sentry-sdk` is installed by default; set the DSN to
# enable error capture for unhandled request exceptions. Leave unset in dev.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
